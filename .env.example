# ============================================================================
# RetailLens Environment Configuration Specification (.env.example)
# Copy this file to .env and customize values for local development or production.
# ============================================================================

# Application Profile Settings
# Options: development | testing | staging | production
APP_ENV=development

# Logging Verbosity Level
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Application Secret Key (Required in Production/Staging)
SECRET_KEY=default-insecure-dev-key

# Managed PostgreSQL Database Credentials (Cloud Neon DB / Supabase / Render / Local)
# You can provide a unified DATABASE_URL OR individual DB_* parameters:
# DATABASE_URL=postgresql://user:password@ep-cool-db.us-east-2.aws.neon.tech/retaillens_db?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retaillens_db
DB_USER=retail_admin
DB_PASSWORD=retail_password
DB_SSLMODE=disable

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Hybrid Compute & Storage Settings
PROCESSING_ENGINE=auto
SPARK_THRESHOLD_MB=100
STORAGE_BACKEND=local
OBJECT_STORAGE_BUCKET=retaillens-data-lake
CLOUD_REGION=us-east-1
REDIS_URL=redis://localhost:6379/0
METRICS_ENABLED=true

# Application Performance & Guardrails
MAX_FILE_SIZE_MB=100
CACHE_TTL_SECONDS=300
